syntax enable
set expandtab
set tabstop=2 shiftwidth=2 softtabstop=2
set list
set listchars=tab:▸\ ,space:.
set laststatus=3
set tags=./.tags;,~/.vimtags
set clipboard=unnamed,unnamedplus
set mouse=a
set completeopt=menu,menuone,noselect
set signcolumn=yes
set updatetime=250
let mapleader = "\<Space>"
filetype plugin indent on
